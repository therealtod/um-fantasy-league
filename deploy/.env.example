DB_URL=jdbc:postgresql://<supabase-host>:5432/postgres
DB_USER=<supabase-db-user>
DB_PASSWORD=<supabase-db-password>
SUPABASE_JWKS_URI=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Optional. Only set this if a frontend deployment calls the API cross-origin
# instead of through the same-origin proxy (frontend/public/_redirects,
# UMFL-01). Leave unset to keep the prod CORS allowlist empty.
FRONTEND_ORIGIN=

# Note: SCRAPER_BASE_URL (where the headless-browser sidecar for the admin match
# import listens) is NOT set here. docker-compose.prod.yml sets it on the
# backend service directly, and a compose `environment:` entry overrides
# `env_file:` -- so a value put here would be silently ignored. Change it in
# that file if the `scraper` service is ever renamed or moved off the box.

# Token for the named Cloudflare Tunnel that publishes the backend as
# api.umfantasyleague.com (docker-compose.prod.yml's `cloudflared` service).
# From the Cloudflare Zero Trust dashboard: Networks -> Tunnels -> the
# umfl-backend tunnel -> Install connector -> copy the token out of the
# `cloudflared tunnel run --token <...>` command it shows you. Rotating it
# means generating a new token for the same tunnel there and updating this
# file -- the tunnel's identity (and so its hostname) stays the same either way.
CLOUDFLARE_TUNNEL_TOKEN=<cloudflare-tunnel-token>
