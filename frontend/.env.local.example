# Copy this file to .env.local (already gitignored) and fill in your Supabase project's values.
# Project Settings -> API in the Supabase dashboard.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# Development only: skips Supabase Auth and sends X-Manager-Id to the dev backend.
# Seeded managers use IDs 1 through 4. This is ignored in production builds.
VITE_DEV_MANAGER_ID=1

# Optional: overrides the dev server's /api proxy target (vite.config.ts).
# Defaults to http://localhost:8080. Only needed when running against a
# tunneled backend (e.g. testing the match-import flow, which needs the
# scraper sidecar reachable from wherever the backend actually runs).
# VITE_API_PROXY_TARGET=https://your-tunnel.trycloudflare.com
