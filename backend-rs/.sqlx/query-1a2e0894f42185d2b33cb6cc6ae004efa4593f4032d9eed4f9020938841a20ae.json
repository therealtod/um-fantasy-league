  "query": "select mg.id, mg.match_id, mg.game_number, mg.map_id, gm.name as map_name\n         from match_game mg\n         join game_map gm on gm.id = mg.map_id\n         where mg.match_id = any($1)\n         order by mg.match_id, mg.game_number",
