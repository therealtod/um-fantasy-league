  "query": "select h.id, h.name, h.image_url, th.cost\n                   from tournament_hero th\n                   join heroes h on h.id = th.hero_id\n                   where th.tournament_id = $1\n                     and ($2::text is null or h.name ilike $2 escape '\\')\n                   order by th.cost desc, h.name asc",
