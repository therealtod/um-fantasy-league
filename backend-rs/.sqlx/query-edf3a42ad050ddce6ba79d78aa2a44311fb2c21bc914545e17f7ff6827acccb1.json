  "query": "select mgs.game_id, mgs.side, mgs.stat, mgs.value\n         from match_game_stats mgs\n         join match_games mg on mg.id = mgs.game_id\n         where mg.match_id = any($1)\n         order by mgs.game_id, mgs.side, mgs.stat",
