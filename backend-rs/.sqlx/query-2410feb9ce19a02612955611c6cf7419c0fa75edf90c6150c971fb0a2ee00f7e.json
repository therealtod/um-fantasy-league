  "query": "select hb.match_id, hb.hero_id, h.name as hero_name, hb.ban_type, hb.side\n         from hero_bans hb\n         join heroes h on h.id = hb.hero_id\n         where hb.match_id = any($1)\n         order by hb.match_id, h.name",
