# Copy to .env.prod and fill in real Supabase credentials, then run:
#   docker compose -f docker-compose.prod.yml up --build
# .env.prod is git-ignored -- never commit real credentials.

# Supabase Postgres. Use the direct connection or Session pooler (port 5432) --
# not the Transaction-mode pooler (port 6543), which breaks the JDBC driver's
# prepared-statement caching that Spring Data JDBC/JdbcClient rely on. Append
# ?sslmode=require. Default database name is "postgres", not "umfl".
DB_URL=jdbc:postgresql://<supabase-host>:5432/postgres?sslmode=require
DB_USER=<supabase-db-user>
DB_PASSWORD=<supabase-db-password>

# Project Settings -> API -> JWT Keys. Only set if the Supabase project uses
# modern JWKS signing keys -- see application-prod.yml if it's a legacy
# HS256-secret project instead.
SUPABASE_JWKS_URI=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Optional. Only needed if a frontend calls this backend cross-origin instead
# of through a same-origin proxy. Leave unset to keep the prod CORS allowlist
# empty.
FRONTEND_ORIGIN=

# Note: SCRAPER_BASE_URL is NOT read from this file -- it's hardcoded in
# docker-compose.prod.yml's backend service (http://scraper:3000), same as
# deploy/docker-compose.prod.yml. A compose `environment:` entry overrides
# `env_file:`, so a value put here would be silently ignored.
